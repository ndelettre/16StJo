/*
========================================================================================
    NEXTFLOW.CONFIG — Configuration du pipeline 16StJo
========================================================================================
    LEÇON : Ce fichier est lu automatiquement par Nextflow au démarrage.
    Il définit :
      1. Les ressources par label (CPU, RAM, temps)
      2. Le budget total d'exécution (executor)
      3. Les conteneurs Docker de chaque outil
      4. Les profils d'exécution (docker, conda, epi2me...)
========================================================================================
*/

docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'
params.outdir     = "output"
params.resultsdir = "results"

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : manifest définit les métadonnées du pipeline.
// EPI2ME utilise ces informations pour afficher le pipeline dans son interface.
// ─────────────────────────────────────────────────────────────────────────────
manifest {
    name            = 'ndelettre/16StJo'
    author          = 'ndelettre'
    description     = 'Pipeline 16S Nanopore (chopper, NanoPlot, Emu) multi-bases - compatible EPI2ME'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
    homePage        = 'https://github.com/ndelettre/16StJo'
}

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : executor définit le budget total de ressources que Nextflow
// peut utiliser simultanément sur toutes les tâches en cours.
// ─────────────────────────────────────────────────────────────────────────────
executor {
    name    = 'local'
    cpus    = 20        // Budget total CPUs (adapte à ta machine)
    memory  = '48 GB'   // Budget total RAM (adapte selon ta RAM disponible)
}

process {

    // Retry UNIQUEMENT sur les erreurs transitoires (OOM killer = 137,
    // segfault = 139, SIGTERM timeout = 143), sinon arrêt propre.
    errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    // Tâches monothread : EMU_COMBINE
    withLabel: 'process_mono' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = '1 h'
    }

    // Tâches légères : CHOPPER, NANOPLOT, EMU_REPORT
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = '2 h'
    }

    // Tâches moyennes : EMU_ABUNDANCE (minimap2 + EM)
    // La RAM dépend surtout de la taille de la base (SILVA > Emu par défaut).
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '6 h'
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Conteneurs Docker (mêmes images que les modules nf-core)
    // ─────────────────────────────────────────────────────────────────────────
    withName: 'CHOPPER'        { container = 'community.wave.seqera.io/library/chopper:0.12.0b--f39108dd84394289' }
    withName: 'NANOPLOT.*'     { container = 'quay.io/biocontainers/nanoplot:1.47.0--pyhdfd78af_0' }
    withName: 'EMU_ABUNDANCE'  { container = 'community.wave.seqera.io/library/emu:3.6.2--0adcfa4809f061f6' }
    withName: 'EMU_COMBINE'    { container = 'community.wave.seqera.io/library/emu:3.6.2--0adcfa4809f061f6' }
    // Image du pipeline phylo (python3 + pandas + plotly + numpy)
    withName: 'EMU_REPORT'     { container = 'nicolasdelettre/phyloreport:1.0.1' }
}

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : Les profils permettent de changer l'environnement d'exécution
// sans modifier le code du pipeline.
//
// Utilisation :
//   nextflow run main.nf -profile docker    ← avec Docker (par défaut)
//   nextflow run main.nf -profile conda     ← avec Conda
//   nextflow run main.nf -profile local     ← outils installés dans le PATH
// ─────────────────────────────────────────────────────────────────────────────
profiles {

    // Profil local : les outils doivent être installés dans le PATH du système
    local {
        docker.enabled   = false
        process.executor = 'local'
    }

    // Profil Docker : chaque process s'exécute dans un conteneur isolé.
    // docker.runOptions passe l'UID/GID de l'hôte au conteneur pour que les
    // fichiers produits appartiennent à l'utilisateur et non à root.
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    // Profil Conda : gestion des dépendances via environnements Conda.
    conda {
        docker.enabled = false
        conda.enabled  = true
        process {
            withName: 'CHOPPER'       { conda = 'bioconda::chopper=0.12.0b' }
            withName: 'NANOPLOT.*'    { conda = 'bioconda::nanoplot=1.47.0' }
            withName: 'EMU_ABUNDANCE' { conda = 'bioconda::emu=3.6.2' }
            withName: 'EMU_COMBINE'   { conda = 'bioconda::emu=3.6.2' }
            withName: 'EMU_REPORT'    { conda = 'conda-forge::python=3.12 conda-forge::pandas conda-forge::plotly' }
        }
    }

    // Profil EPI2ME : configuration pour EPI2ME Desktop.
    // Pour intégrer ce pipeline : EPI2ME Desktop → Import workflow → URL GitHub.
    epi2me {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor  = 'local'
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Dossier de travail temporaire de Nextflow.
// En cas d'erreur : cat work/xx/yyyyyyyy/.command.err
// ─────────────────────────────────────────────────────────────────────────────
workDir = 'work'

// ─────────────────────────────────────────────────────────────────────────────
// Rapports d'exécution Nextflow (ressources, chronologie, graphe du pipeline)
// ─────────────────────────────────────────────────────────────────────────────
report   { enabled = true; file = "${params.outdir}/pipeline_report.html";   overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_timeline.html"; overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_dag.html";      overwrite = true }
