/*
========================================================================================
    NEXTFLOW.CONFIG — Configuration du pipeline ARN16StJo
========================================================================================
    Ce fichier est lu automatiquement par Nextflow au démarrage.
    Il définit :
      1. Les métadonnées du pipeline (affichées par EPI2ME)
      2. Le budget total d'exécution (executor)
      3. Les ressources par label et les images Docker par process
      4. Les profils d'exécution (docker, epi2me)
========================================================================================
*/

docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'

// ─────────────────────────────────────────────────────────────────────────────
// PARAMÈTRES PAR DÉFAUT (modifiables dans EPI2ME ou avec --nom_parametre)
// LEÇON : les valeurs par défaut sont ici et non dans main.nf : avec la
// syntaxe stricte de Nextflow, les paramètres déclarés dans main.nf ne sont
// plus vus par les process.
// ─────────────────────────────────────────────────────────────────────────────
params {
    fastq_dir   = null       // Dossier contenant les FASTQ (obligatoire)
    outdir      = "output"   // Dossier de sortie des rapports HTML
    resultsdir  = "results"  // Dossier de sortie des fichiers intermédiaires
    min_length  = 1200       // Longueur minimale des reads (Chopper)
    max_length  = 1800       // Longueur maximale des reads (Chopper)
    min_quality = 10         // Q-score moyen minimal des reads (Chopper)
}

manifest {
    name            = 'ndelettre/ARN16StJo'
    author          = 'ndelettre'
    description     = 'Pipeline 16S full-length Nanopore (EMU) - compatible EPI2ME'
    version         = '0.1.0'
    nextflowVersion = '>=22.10.0'
    mainScript      = 'main.nf'
    homePage        = 'https://github.com/ndelettre/ARN16StJo'
}

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : executor définit le budget total de ressources que Nextflow peut
// utiliser simultanément sur toutes les tâches en cours. Avec 94 échantillons,
// Nextflow lance autant de tâches en parallèle que ce budget le permet.
// ─────────────────────────────────────────────────────────────────────────────
executor {
    name    = 'local'
    cpus    = 20        // Budget total CPUs (PC bioinfo EPI2ME)
    memory  = '48 GB'   // Budget total RAM
}

process {

    // Retry UNIQUEMENT sur les erreurs transitoires (OOM killer = 137,
    // segfault = 139, SIGTERM timeout = 143). Pour les vraies erreurs
    // logiques, 'finish' laisse les autres tâches se terminer proprement.
    errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    // Tâches monothread : NanoStat
    withLabel: 'process_mono' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = '1 h'
    }

    // Tâches légères : Chopper
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = '1 h'
    }

    // ─────────────────────────────────────────────────────────────────────────
    // LEÇON : images Docker FIGÉES (tag exact, jamais "latest") pour qu'une
    // mise à jour d'un outil ne change pas les résultats ou n'introduise pas
    // de bug sans qu'on le décide.
    // LEÇON : NanoStat est importé sous deux alias dans main.nf : chacun a
    // besoin de sa ligne withName.
    // ─────────────────────────────────────────────────────────────────────────
    withName: 'NANOSTAT_RAW'      { container = 'quay.io/biocontainers/nanostat:1.6.0--pyhdfd78af_0' }
    withName: 'NANOSTAT_FILTERED' { container = 'quay.io/biocontainers/nanostat:1.6.0--pyhdfd78af_0' }
    withName: 'CHOPPER'           { container = 'quay.io/biocontainers/chopper:0.9.0--hdcf5f25_0' }
}

profiles {

    // Profil Docker : chaque process s'exécute dans son conteneur.
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    // Profil EPI2ME : configuration pour EPI2ME Desktop
    // (Workflows → Import Local Workflow, ou import depuis GitHub).
    epi2me {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor  = 'local'
    }
}

workDir = 'work'

// ─────────────────────────────────────────────────────────────────────────────
// Rapports Nextflow générés automatiquement à la fin du pipeline.
// ─────────────────────────────────────────────────────────────────────────────
report   { enabled = true; file = "${params.outdir}/pipeline_report.html";   overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_timeline.html"; overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_dag.svg";       overwrite = true }
